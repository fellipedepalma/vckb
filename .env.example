# Token required in `Authorization: Bearer <token>` (min. 16 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# The server refuses to start while this is empty.
VCKB_TOKEN=

# Where the boards live. Relative paths are resolved from the VCKB install directory.
# Recommended: point this to a separate PRIVATE git repo with your real boards.
VCKB_BOARDS_DIR=./boards

# API bind address/port. Keep 127.0.0.1 unless you know what you are doing.
VCKB_HOST=127.0.0.1
VCKB_PORT=8787

# Comma-separated origins allowed by CORS. Empty = same-origin only.
VCKB_CORS_ORIGINS=

# Extra host names the server answers to (Host header; others get 421, against DNS rebinding).
# localhost, 127.0.0.1, [::1] and VCKB_HOST are always allowed. Add your Tailscale name/IP or LAN IP
# here when you open VCKB from another device, e.g.: my-pc.tailnet-name.ts.net,100.101.102.103
VCKB_ALLOWED_HOSTS=

# Extra origins accepted by the web UI's CSRF check, besides the request's own host
# (e.g. https://my-pc.tailnet-name.ts.net when a proxy changes the host). Usually empty.
VCKB_ALLOWED_ORIGINS=

# Set to true ONLY behind a reverse proxy you control (e.g. `tailscale serve`): then
# X-Forwarded-Proto marks the session cookie Secure and X-Forwarded-For is used for rate limiting.
VCKB_TRUST_PROXY=false

# --- Docker only (read by docker-compose.yml; ignored by `npm start`) ---
# Host IP the container port is published on. Default 127.0.0.1 (this machine only).
# For other devices use ONE private IP: your Tailscale IP (`tailscale ip -4`) or LAN IP. Never 0.0.0.0.
VCKB_BIND_IP=127.0.0.1
VCKB_HOST_PORT=8787
# Container user; set to the owner of VCKB_BOARDS_DIR on the host (`id -u` / `id -g`).
VCKB_UID=1000
VCKB_GID=1000
