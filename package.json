{
  "name": "vckb",
  "version": "0.1.0",
  "description": "Vibe Coding Kanban: a file-based kanban (Markdown + YAML frontmatter) that humans and AI coding agents share via web UI, CLI or REST API.",
  "keywords": [
    "kanban",
    "markdown",
    "ai-agents",
    "vibe-coding",
    "cli",
    "task-manager",
    "claude-code",
    "agents-md"
  ],
  "homepage": "https://github.com/fellipedepalma/vckb#readme",
  "bugs": {
    "url": "https://github.com/fellipedepalma/vckb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fellipedepalma/vckb.git"
  },
  "license": "MIT",
  "author": "Fellipe",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "vckb": "bin/vckb.js"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "node dist/server/index.js",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "audit": "npm audit --omit=dev",
    "vckb": "node bin/vckb.js",
    "demo": "node scripts/demo.mjs",
    "test:e2e:stress": "npm run build && playwright test --config playwright.stress.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "chokidar": "^5.0.0",
    "dotenv": "^18.0.4",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.12",
    "js-yaml": "^5.4.2",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
